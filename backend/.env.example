# ---------------------------------------------------------------------------
# ResumeIQ backend — environment configuration
# Copy this file to .env and fill in real values. Never commit .env itself.
# ---------------------------------------------------------------------------

# --- Server ---
NODE_ENV=development
# Matches the Google Cloud Console origin/redirect config in the SRS request.
PORT=3000
# Where the frontend (Vite) is running — used for CORS and post-OAuth redirects.
FRONTEND_URL=http://localhost:5173

# --- Database (PostgreSQL) ---
# Either set DATABASE_URL directly, or the individual PG* vars below.
DATABASE_URL=postgres://resumeiq:resumeiq_password@localhost:5432/resumeiq
PGSSL=false

# --- Auth / JWT ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Password hashing ---
BCRYPT_SALT_ROUNDS=12

# --- Google OAuth 2.0 ---
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
#   Authorized JavaScript origin:  http://localhost:3000
#   Authorized redirect URI:       http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# --- Google Gemini API (NLP / ML, per SDD Section 2.5) ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# --- File uploads ---
MAX_UPLOAD_MB=5
UPLOAD_DIR=uploads

# --- Field-level encryption at rest (NFR-SE2) ---
# 32-byte key, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=replace-this-with-a-base64-32-byte-key

# --- Rate limiting / graceful degradation (NFR-P2, NFR-S3) ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
ANALYZE_CONCURRENCY=8
ANALYZE_QUEUE_LIMIT=200

# --- Backups (NFR-S1) ---
BACKUP_DIR=backups
BACKUP_CRON=0 3 * * *
# Optional: only needed if pg_dump is not on PATH
PG_DUMP_PATH=pg_dump

# --- Logging ---
LOG_LEVEL=info
