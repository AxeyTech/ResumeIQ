{
  "name": "resumeiq-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ResumeIQ backend API — Node.js + Express + PostgreSQL + Google Gemini API, implementing ResumeIQ SRS v1.0.",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "nodemon --watch src --ext js,sql src/server.js",
    "start": "node src/server.js",
    "migrate": "node src/db/migrate.js up",
    "migrate:down": "node src/db/migrate.js down",
    "migrate:status": "node src/db/migrate.js status",
    "backup": "node src/jobs/backup.job.js --once",
    "lint": "eslint src"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.8.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^10.1.2",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.15.1",
    "pg": "^8.13.1",
    "winston": "^3.15.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "eslint": "^9.14.0",
    "nodemon": "^3.1.7"
  }
}
